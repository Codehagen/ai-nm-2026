{
  "name": "task-1-tripletex",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api.ts",
    "start": "tsx src/api.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "review": "tsx scripts/review.ts",
    "replay": "tsx scripts/replay.ts",
    "replay:failed": "tsx scripts/replay.ts --all-failed",
    "replay:mock": "tsx scripts/replay.ts --mock",
    "restart": "lsof -ti:9053 | xargs kill -9 2>/dev/null; sleep 1; tsx src/api.ts",
    "test": "vitest run tests/mock-crud.test.ts",
    "test:watch": "vitest tests/mock-crud.test.ts",
    "test:conformance": "vitest run tests/conformance.test.ts",
    "mock:start": "tsx src/mock/server.ts",
    "benchmark": "tsx tests/benchmark.ts",
    "benchmark:tier1": "tsx tests/benchmark.ts --tier 1",
    "benchmark:tier2": "tsx tests/benchmark.ts --tier 2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/gateway": "^3.0.66",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "ai": "^6.0.116",
    "hono": "^4.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
